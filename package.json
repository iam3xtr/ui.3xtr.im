{
    "name": "trickster-ui-kit",
    "private": true,
    "license": "MIT",
    "type": "module",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.15.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": "^11.0.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:pages": "vite build --mode pages",
        "preview": "vite preview",
        "guard:no-component-styles": "node scripts/no-component-styles.js",
        "lint:style": "npm run guard:no-component-styles",
        "test:unit": "vitest run",
        "test:unit:sources": "vitest run --mode development",
        "release:ui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-packages.ps1 -Package ui",
        "release:vue": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-packages.ps1 -Package vue",
        "release:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-packages.ps1 -Package all"
    },
    "dependencies": {
        "@iam3xtr/ui": "0.1.4",
        "@iam3xtr/vue": "0.1.4",
        "@mdi/font": "^7.4.47",
        "buefy": "^3.1.0",
        "bulma": "^1.0.4",
        "pinia": "^4.1.0",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.44",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.1.3",
        "postcss-scss": "^4.0.9",
        "sass": "^1.106.1",
        "stylelint": "^17.16.0",
        "stylelint-config-recommended": "^18.0.0",
        "vite": "^8.3.5",
        "vite-svg-loader": "^5.1.1",
        "vitest": "^5.0.5"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true
    }
}
